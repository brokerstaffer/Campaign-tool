# ---- EmailBison -------------------------------------------------------------
# One workspace, one token. Base URL is overridable so a second instance is a
# config change rather than a code change.
EMAILBISON_BASE_URL=https://send.brokerstaffer.com
EMAILBISON_API_KEY=

# ---- Supabase ---------------------------------------------------------------
# Service role only. The browser never holds a Supabase client — every read goes
# through /api/analytics/*, so the anon key is deliberately absent.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth -------------------------------------------------------------------
# Newline- or comma-separated list of  email:sha256hex  pairs.
# Generate a hash:  node -e "console.log(require('crypto').createHash('sha256').update('yourpassword').digest('hex'))"
AUTH_USERS=
# 32+ random bytes. openssl rand -hex 32
AUTH_SECRET=

# ---- Cron -------------------------------------------------------------------
# Bearer token guarding /api/cron/*. openssl rand -hex 32
CRON_SECRET=

# ---- Optional ---------------------------------------------------------------
# Exposes /api/analytics/reconcile. Never enable in production.
ENABLE_RECONCILE=false
