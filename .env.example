# ---- EmailBison -------------------------------------------------------------
# One workspace, one token. Base URL is overridable so a second instance is a
# config change rather than a code change.
EMAILBISON_BASE_URL=https://send.brokerstaffer.com
EMAILBISON_API_KEY=

# ---- Supabase ---------------------------------------------------------------
# Service role only. The browser never holds a Supabase client — every read goes
# through /api/analytics/*, so the anon key is deliberately absent.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Auth -------------------------------------------------------------------
# Newline- or comma-separated list of  email:sha256hex  pairs.
# Generate a hash:  node -e "console.log(require('crypto').createHash('sha256').update('yourpassword').digest('hex'))"
AUTH_USERS=
# 32+ random bytes. openssl rand -hex 32
AUTH_SECRET=

# ---- Cron -------------------------------------------------------------------
# Bearer token guarding /api/cron/*. openssl rand -hex 32
# Unset means the routes fail CLOSED (503), not open.
CRON_SECRET=

# Scheduling is Railway cron: a cron service runs scripts/cron-dispatch.mjs
# every 10 minutes and triggers whatever src/lib/sync/schedule.ts says is due.
# ENABLE_SCHEDULER=1 turns on the in-process ticker instead — the fallback for
# environments with no cron service. Both at once is safe (runJob holds a lock);
# off by default only because one scheduler is easier to reason about.
ENABLE_SCHEDULER=

# ---- Cron service only (scripts/cron-dispatch.mjs) --------------------------
# Where to send triggers. Must be the web service's public URL.
APP_URL=
# Must equal the cron interval, so each scheduled minute falls in one window.
CRON_WINDOW_MINUTES=10

# EmailBison workspace id. Every table's team_id.
EMAILBISON_TEAM_ID=2

# ---- Portal -----------------------------------------------------------------
# The client roster, refreshed by sync-entities. Optional: without it the
# matcher runs against the clients already stored rather than unassigning
# everything.
PORTAL_BASE_URL=
PORTAL_TOKEN=

# ---- Optional ---------------------------------------------------------------
# Exposes /api/analytics/reconcile. Never enable in production.
ENABLE_RECONCILE=false
